	title = {Science in a {Democratic} {Society}},
	isbn = {978-1-61614-407-4},
	abstract = {In this successor to his pioneering Science, Truth, and Democracy, the author revisits the topic explored in his previous work-namely, the challenges of integrating science, the most successful knowledge-generating system of all time, with the problems of democracy. But in this new work, the author goes far beyond that earlier book in studying places at which the practice of science fails to answer social needs. He considers a variety of examples of pressing concern, ranging from climate change to religiously inspired constraints on biomedical research to the neglect of diseases that kill millions of children annually, analyzing the sources of trouble. He shows the fallacies of thinking that democracy always requires public debate of issues most people cannot comprehend, and argues that properly constituted expertise is essential to genuine democracy. No previous book has treated the place of science in democratic society so comprehensively and systematically, with attention to different aspects of science and to pressing problems of our times.},
	language = {en},
	publisher = {Prometheus Books},
	author = {Kitcher, Philip},
	year = {2011},
	note = {Google-Books-ID: RJggkgAACAAJ},
	keywords = {Philosophy / Political, Science / Philosophy \& Social Aspects, Social Science / Sociology / Social Theory},
	file = {PDF:/Users/amin/Zotero/storage/2TVIT5E2/Kitcher - 2011 - Science in a Democratic Society.pdf:application/pdf},
}


